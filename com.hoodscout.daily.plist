<?xml version="1.0" encoding="UTF-8"?>
<!--
  HoodScout daily refresh.

  Installed copy lives at ~/Library/LaunchAgents/com.hoodscout.daily.plist;
  this one is the version-controlled original. To reinstall:

    cp com.hoodscout.daily.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.hoodscout.daily.plist 2>/dev/null
    launchctl load  ~/Library/LaunchAgents/com.hoodscout.daily.plist

  Fires at 02:00 local. Every metric on the page is keyed to the last complete
  UTC day, so the run has to sit far enough past UTC midnight that the upstream
  providers have finished ingesting it -- Blockscout in particular publishes a
  calendar-complete bucket hours before it stops filling. 02:00 PDT is 09:00
  UTC, a nine-hour margin.

  If the Mac is asleep at 02:00 launchd runs the job on the next wake, so a
  closed lid delays the refresh rather than skipping the day.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hoodscout.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/raincityanalytics/projects/robinhood-chain-pulse/refresh.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/raincityanalytics/projects/robinhood-chain-pulse</string>

    <key>StandardOutPath</key>
    <string>/Users/raincityanalytics/projects/robinhood-chain-pulse/out/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/raincityanalytics/projects/robinhood-chain-pulse/out/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
