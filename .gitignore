# API keys — never commit. In CI these live in GitHub Secrets.
.env

__pycache__/
*.pyc

# Generated outputs are rebuilt every run, so tracking them would mean a
# permanently dirty tree. The LEDGERS are the exception: they are append-only
# observation history that cannot be reconstructed afterwards (GeckoTerminal
# only exposes the last ~53 minutes), so they are the one thing in out/ worth
# version control.
out/*
!out/launches.jsonl
!out/nft_launches.jsonl
!out/nft_registry.json
!out/nft_names.json
# verified wage-pool addresses: a discovery cache, re-measured every run
!out/wage_pools.json

# The RENDERED SITE is committed so Cloudflare Pages can deploy straight from
# the repo with no build step and no API token: GitHub Actions builds it, Pages
# watches the branch. Build artifacts in git is normally a smell; here it is the
# thing that removes a secret from the pipeline entirely.
!out/site/
!out/site/**

# wrangler caches the Cloudflare account id and the account owner email.
# Harmless locally, unnecessary exposure in a public repo.
.wrangler/
